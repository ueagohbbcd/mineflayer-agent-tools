{
  "name": "mineflayer-world-memory",
  "version": "0.1.0",
  "description": "Mineflayer agent toolkit: chunk history, perception queries, visuals, watchdogs, and a shell runtime (mf) for driving characters step by step",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueagohbbcd/mineflayer-agent-tools.git"
  },
  "homepage": "https://github.com/ueagohbbcd/mineflayer-agent-tools#readme",
  "bugs": {
    "url": "https://github.com/ueagohbbcd/mineflayer-agent-tools/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:visual": "python3 -m unittest discover -s test -p \"visual_*_test.py\""
  },
  "dependencies": {
    "prismarine-chunk": "^1.41.0",
    "prismarine-registry": "^1.1.0",
    "prismarine-block": "^1.23.0",
    "vec3": "^0.2.0"
  },
  "peerDependencies": {
    "mineflayer": ">=4.39.0 <5",
    "prismarine-viewer": "^1.33.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-item": "^1.17.0",
    "minecraft-data": "^3.114.0"
  },
  "bin": {
    "world-memory": "bin/world-memory.js",
    "mf": "runtime/bin/mf.mjs"
  },
  "files": [
    "index.js",
    "reader.js",
    "reader.mjs",
    "lib/*.js",
    "bin/*.js",
    "renderers/*.py",
    "renderers/requirements.txt",
    "docs/*.md",
    "skills/**/*.md",
    "README.md",
    "LICENSE",
    "examples/*.js",
    "live.js",
    "live.mjs",
    "queries.js",
    "queries.mjs",
    "watchdog.js",
    "watchdog.mjs",
    "runtime/**/*.mjs",
    "runtime/README.md"
  ],
  "devDependencies": {
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5"
  },
  "peerDependenciesMeta": {
    "prismarine-viewer": {
      "optional": true
    }
  }
}
