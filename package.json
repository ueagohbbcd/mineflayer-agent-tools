{
  "name": "mineflayer-world-memory",
  "version": "0.1.0",
  "description": "Mineflayer agent toolkit: one game process that holds the bot (game/), chunk history, perception queries, visuals and watchdogs",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueagohbbcd/mineflayer-agent-tools.git"
  },
  "homepage": "https://github.com/ueagohbbcd/mineflayer-agent-tools#readme",
  "bugs": {
    "url": "https://github.com/ueagohbbcd/mineflayer-agent-tools/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "build:bundle": "node scripts/build-bundle.mjs",
    "test:visual": "python3 -m unittest discover -s test -p \"visual_*_test.py\"",
    "demo:screenshot": "node game/dev/render-fixture.mjs"
  },
  "dependencies": {
    "prismarine-chunk": "^1.41.0",
    "prismarine-registry": "^1.1.0",
    "prismarine-block": "^1.23.0",
    "proper-lockfile": "^4.1.2",
    "vec3": "^0.2.0"
  },
  "peerDependencies": {
    "mineflayer": ">=4.39.0 <5",
    "prismarine-viewer": "^1.33.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-item": "^1.17.0",
    "minecraft-data": "^3.114.0",
    "mineflayer-pvp": "^1.3.2"
  },
  "bin": {
    "world-memory": "bin/world-memory.js"
  },
  "files": [
    "index.js",
    "reader.js",
    "reader.mjs",
    "lib/*.js",
    "bin/*.js",
    "renderers/*.py",
    "renderers/requirements.txt",
    "docs/*.md",
    "skills/**/*.md",
    "bundle/**/*.md",
    "README.md",
    "LICENSE",
    "examples/*.js",
    "examples/*.mjs",
    "live.js",
    "live.mjs",
    "queries.js",
    "queries.mjs",
    "watchdog.js",
    "watchdog.mjs",
    "game/**/*.mjs",
    "game/**/*.md"
  ],
  "devDependencies": {
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-pvp": "1.3.2"
  },
  "peerDependenciesMeta": {
    "prismarine-viewer": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "canvas": "3.2.3",
    "gl": "9.0.0-rc.10",
    "prismarine-viewer": "1.33.0"
  }
}
