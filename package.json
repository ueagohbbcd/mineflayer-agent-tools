{
  "name": "mineflayer-world-memory",
  "version": "0.1.0",
  "description": "Persistent exposed-world exploration memory for Mineflayer",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "test:visual": "python3 -m unittest discover -s test -p \"visual_*_test.py\""
  },
  "dependencies": {
    "prismarine-chunk": "^1.41.0",
    "prismarine-registry": "^1.1.0",
    "prismarine-block": "^1.23.0",
    "vec3": "^0.2.0"
  },
  "peerDependencies": {
    "mineflayer": ">=4.39.0 <5",
    "prismarine-viewer": "^1.33.0"
  },
  "bin": {
    "world-memory": "bin/world-memory.js"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "bin/*.js",
    "renderers/*.py",
    "renderers/requirements.txt",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "examples/*.js",
    "live.js",
    "live.mjs",
    "queries.js",
    "queries.mjs",
    "watchdog.js",
    "watchdog.mjs"
  ],
  "devDependencies": {
    "mineflayer": "4.39.0"
  },
  "peerDependenciesMeta": {
    "prismarine-viewer": {
      "optional": true
    }
  }
}
